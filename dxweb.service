[Unit]
Description=DXSpider Web
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/spider/dxweb
Environment=DXS_HOST=127.0.0.1
Environment=DXS_PORT=27754
Environment=HTTP_HOST=127.0.0.1
Environment=HTTP_PORT=7480
Environment=MOJO_REVERSE_PROXY=1
ExecStart=/bin/sh /spider/dxweb/start.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
