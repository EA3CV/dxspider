[Unit]
Description=DXSpider dxweb-admin
After=network.target

[Service]
Type=simple
User=sysop
Group=spider
WorkingDirectory=/spider/dxweb-admin
Environment=DXS_HOST=127.0.0.1
Environment=DXS_PORT=27754
Environment=DXWEB_HOST=0.0.0.0
Environment=DXWEB_PORT=7381
Environment=DXWEB_CLIENT_PORT=7380
Environment=DXWEB_CLIENT_SCHEME=http
Environment=DXWEB_CLIENT_HOST=127.0.0.1
Environment=DXWEB_SCHEME=http
Environment=MOJO_REVERSE_PROXY=0
Environment=DXSPIDER_ROOT=/spider
ExecStart=/usr/bin/perl /spider/dxweb-admin/admin.pl
Restart=on-failure
RestartSec=3
TimeoutStopSec=20s
KillMode=mixed

[Install]
WantedBy=multi-user.target
